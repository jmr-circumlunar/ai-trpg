[Unit]
Description=ai-trpg (multi-agent TRPG engine)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/ai-trpg
EnvironmentFile=/opt/ai-trpg/.env
ExecStart=/opt/ai-trpg/.venv/bin/uvicorn api:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=3
MemoryMax=800M
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
